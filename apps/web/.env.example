# Base URL of the Jam Room API (Railway URL in prod, localhost in dev)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Google Maps Embed API key — enables the real map on room detail pages.
# Create at https://console.cloud.google.com → enable "Maps Embed API"
# (free, unlimited loads). Restrict the key by HTTP referrer for safety.
# If unset, the page falls back to a decorative map placeholder.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
