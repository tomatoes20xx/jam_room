# Postgres connection (Railway provides this automatically in prod)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jamroom?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Public base URL of THIS api (used for OAuth callbacks). Local dev:
BETTER_AUTH_URL="http://localhost:4000"

# Google OAuth (https://console.cloud.google.com -> Credentials -> OAuth client)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# uploadthing (https://uploadthing.com -> API Keys)
UPLOADTHING_TOKEN=""

# Frontend origin allowed by CORS (the Vercel URL in prod)
WEB_ORIGIN="http://localhost:3000"

# Port the API listens on
PORT="4000"
