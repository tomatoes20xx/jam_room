{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @jamroom/api db:generate"
  },
  "deploy": {
    "startCommand": "pnpm --filter @jamroom/api db:deploy && pnpm --filter @jamroom/api start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
